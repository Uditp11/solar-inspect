# configs/d2.yaml is regenerated by scripts/split_d2.py. Without this, the script's
# Windows default line endings differ from what git checks out, so every run left the
# working tree dirty with a diff that contained no actual change.
*.yaml text eol=lf

# configs/d1_split.json is regenerated by scripts/split_d1.py, same reason.
*.json text eol=lf
